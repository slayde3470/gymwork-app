+        keyboardActions = KeyboardActions(onDone = { if (만졌나) 넣기(글값); 만졌나 = false; 초점.clearFocus() }),
+        modifier = Modifier
+            .widthIn(max = 64.dp)
+            .onFocusChanged { if (!it.isFocused && 만졌나) { 넣기(글값); 만졌나 = false } },

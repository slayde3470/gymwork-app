+/** 목록 한 줄 (시트 안에서 고르는 것) */
+@Composable
+fun 고르기줄(이름: String, 곁: String? = null, 오른쪽: ImageVector? = 아이콘.오른쪽, 흐림: Boolean = false, onClick: () -> Unit) {

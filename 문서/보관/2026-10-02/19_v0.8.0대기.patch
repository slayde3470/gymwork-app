+private fun 고치기(상태: 앱상태, 종목이름: String, f: (플랜) -> 플랜) {
+    상태.바꿈 { d -> d.copy(플랜들 = d.플랜들.map { if (it.종목 == 종목이름) f(it) else it }) }
+}

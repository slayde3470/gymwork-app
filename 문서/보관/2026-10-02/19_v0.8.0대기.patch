+/** 남은 주 — 너무 멀면 지어내지 않는다 */
+private fun 남은주글(주: Int): String = when {
+    주 <= 0 -> "달성"
+    주 >= 플랜표.최대주 -> "20년 이상"
+    주 >= 260 -> "%.1f년".format(주 / 52.0)
+    else -> "${주}주"
+}

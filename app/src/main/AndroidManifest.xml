<?xml version="1.0" encoding="utf-8"?>
<!--
  이 파일은 안드로이드에게 앱을 소개하는 명함이다.
  앱 이름, 아이콘, 어떤 화면부터 시작하는지, 어떤 권한이 필요한지를 적는다.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 휴식이 끝나면 진동으로 알린다 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 참고 링크가 유튜브면 작은 그림(썸네일)을 받아 온다 (09-27). 그 밖엔 인터넷을 쓰지 않는다 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 화면이 꺼져 있어도 휴식 끝을 알린다 (09-26) — 알림 · 제시각 알람 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <!-- 운동 중 다른 앱(유튜브 작은 창 등) 위에 작은 동그라미를 띄운다 (10-08) — 설정에서 사용자가 허용해야 켜진다 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hasenheide">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:launchMode="singleTask"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden"
            android:theme="@style/Theme.Hasenheide">
            <!-- 이 줄들이 "앱 서랍의 아이콘을 누르면 이 화면부터 시작" 이라는 뜻 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 휴식 끝 알람을 받는 곳 — 앱이 꺼져 있어도 폰이 깨워 부른다 -->
        <receiver android:name=".RestAlarmReceiver" android:exported="false" />

        <!-- 운동 보고서 이미지 공유 (10-05) — 공유 창에 넘길 png 를 앱 캐시 report/ 에서 꺼내 준다. 권한은 받는 앱이 읽는 동안만 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/report_paths" />
        </provider>
    </application>
</manifest>
